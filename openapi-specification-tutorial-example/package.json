{
  "name": "openapi-specification-tutorial-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "lint:broken": "redocly lint openapi-broken.yaml",
    "docs": "redocly build-docs openapi.yaml --output docs/index.html",
    "mock": "prism mock openapi.yaml",
    "client": "openapi-generator-cli generate -i openapi.yaml -g typescript-fetch -o client",
    "client:run": "tsx use-client.ts"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@stoplight/prism-cli": "5.16.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
