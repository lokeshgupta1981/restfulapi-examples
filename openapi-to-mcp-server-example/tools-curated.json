              },
              "name": {
                "type": "string"
              },
              "team": {
                "type": "string"
              }
            },
            "type": "object",
            "required": [
              "id",
              "name",
              "team"
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "result"
      ],
      "x-fastmcp-wrap-result": true
    },
    "annotations": {
      "readOnlyHint": true
    },
    "_meta": {
