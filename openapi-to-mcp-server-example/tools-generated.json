              "const": "public_reply"
            },
            {
              "type": "string",
              "const": "internal_note"
            }
          ],
          "description": "Selects the variant. Accepted values: 'public_reply', 'internal_note'. 'public_reply' uses kind, body, notify_customer; 'internal_note' uses kind, body, mention. Send only the fields belonging to the selected variant."
        },
        "body": {
          "type": "string"
        },
        "notify_customer": {
          "type": "boolean",
          "default": true
