// Settings for the orders service (JSON with Comments)
{
  "port": 8080,
  /* The payment provider's sandbox URL.
     Switch to the live URL only in production. */
  "paymentUrl": "https://sandbox.pay.example.com/v2",
  "retry": {
    "maxAttempts": 3,   // give up after the third failure
    "backoffMs": 200
  }
}
